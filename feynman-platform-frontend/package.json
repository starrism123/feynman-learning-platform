{
  "name": "feynman-platform-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:desktop": "vite build --mode electron",
    "electron:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "electron:start": "npm run build:desktop && electron .",
    "electron:build": "npm run build:desktop && electron-builder --win nsis",
    "electron:build:no-icon": "npm run build:desktop && electron-builder --win nsis -c.win.signAndEditExecutable=false",
    "electron:build:dir": "npm run build:desktop && electron-builder --win --dir"
  },
  "dependencies": {
    "@uiw/react-md-editor": "^4.1.5",
    "axios": "^1.20.0",
    "d3-force-3d": "^3.0.6",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "katex": "^0.19.1",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-katex": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "wait-on": "^9.5.1"
  },
  "description": "费曼学习平台前端：网页版（PWA）和桌面版（Electron）",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.feynman-platform.app",
    "productName": "Feynman Learning Platform",
    "files": [
      "dist-desktop/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/pwa-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
